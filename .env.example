# Plantilla de variables de entorno. Copiar a .env.local y rellenar.
#
#   cp .env.example .env.local
#
# .env.local NUNCA se commitea. Los valores salen de:
# Supabase → Project Settings → API Keys / Data API

# URL del proyecto. Ej: https://abcdefghijklm.supabase.co
# OJO: no es la URL del dashboard.
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (publishable, formato sb_publishable_...; antes se llamaba anon).
# Viaja al navegador por diseño; lo que protege los datos es Row Level Security,
# no esconder esta clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ref del proyecto: el tramo final de la URL del dashboard,
# https://supabase.com/dashboard/project/<ESTO>
# Solo lo usa `npm run db:types`; no llega al navegador.
SUPABASE_PROJECT_ID=

# La clave de servicio (service_role / secret) NO va aquí ni en ningún archivo
# con prefijo NEXT_PUBLIC_. Se salta RLS por completo. Cuando haga falta, se
# agrega como SUPABASE_SERVICE_ROLE_KEY y se usa exclusivamente en servidor.
